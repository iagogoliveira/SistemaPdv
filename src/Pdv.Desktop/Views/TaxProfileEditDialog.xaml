<Window x:Class="Pdv.Desktop.Views.TaxProfileEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pdv.Desktop.Controls"
        Title="{Binding Title}" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="14"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" Background="{StaticResource SurfaceBrush}"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="24,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrandSoftBrush}">
                <ui:IconView Data="{StaticResource Icon.Receipt}" Foreground="{StaticResource BrandBrush}" Width="22" Height="22" />
            </Border>
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <ui:IconView Data="{StaticResource Icon.Alert}" Foreground="{StaticResource WarningBrush}" Width="18" Height="18" Margin="0,0,10,0" />
                <TextBlock TextWrapping="Wrap" Width="490" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding RegimeHint, Mode=OneWay}" />
                    <Run Text="Códigos e alíquotas dependem da UF e do produto: confirme com o contador." />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Nome do perfil" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="2" Text="CFOP" Style="{StaticResource Caption}" />
            <TextBox x:Name="NameBox" Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: Revenda — Simples Nacional"
                     Margin="0,4,0,14" MaxLength="80" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Cfop, UpdateSourceTrigger=PropertyChanged}" Tag="5102" Margin="0,4,0,14" MaxLength="4" />

            <TextBlock Grid.Row="2" Text="{Binding IcmsLabel}" Style="{StaticResource Caption}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Alíquota ICMS (%)" Style="{StaticResource Caption}" />
            <ComboBox Grid.Row="3" ItemsSource="{Binding IcmsCodes}" SelectedItem="{Binding IcmsCode}" DisplayMemberPath="Label" Margin="0,4,0,14" />
            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding IcmsRate, UpdateSourceTrigger=PropertyChanged}" Tag="0" Margin="0,4,0,14" />

            <TextBlock Grid.Row="4" Text="CST do PIS" Style="{StaticResource Caption}" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="Alíquota PIS (%)" Style="{StaticResource Caption}" />
            <ComboBox Grid.Row="5" ItemsSource="{Binding PisCofinsCodes}" SelectedItem="{Binding PisCst}" DisplayMemberPath="Label" Margin="0,4,0,14" />
            <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding PisRate, UpdateSourceTrigger=PropertyChanged}" Tag="0" Margin="0,4,0,14" />

            <TextBlock Grid.Row="6" Text="CST da COFINS" Style="{StaticResource Caption}" />
            <TextBlock Grid.Row="6" Grid.Column="2" Text="Alíquota COFINS (%)" Style="{StaticResource Caption}" />
            <ComboBox Grid.Row="7" ItemsSource="{Binding PisCofinsCodes}" SelectedItem="{Binding CofinsCst}" DisplayMemberPath="Label" Margin="0,4,0,14" />
            <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding CofinsRate, UpdateSourceTrigger=PropertyChanged}" Tag="0" Margin="0,4,0,14" />

            <StackPanel Grid.Row="9" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,-4,0">
                <Button Content="Cancelar" IsCancel="True" MinWidth="90" />
                <Button Content="Salvar" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="OnSave" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
