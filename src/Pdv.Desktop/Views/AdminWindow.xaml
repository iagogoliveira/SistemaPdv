<Window x:Class="Pdv.Desktop.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema PDV — Retaguarda" Width="1100" Height="680" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="14">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <TabControl x:Name="Tabs" Margin="8">
        <TabItem Header="Produtos e estoque" Visibility="{Binding ShowProductsTab, Converter={StaticResource BoolToVisibility}}">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <CheckBox DockPanel.Dock="Right" Content="Mostrar inativos" IsChecked="{Binding IncludeInactive}"
                              VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Buscar" Command="{Binding SearchProductsCommand}" />
                    <TextBox Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}" FontSize="16">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchProductsCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Novo" Command="{Binding NewProductCommand}" Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding CanManageProducts, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Editar" Command="{Binding EditSelectedProductCommand}"
                            Visibility="{Binding CanManageProducts, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Ativar / desativar" Command="{Binding ToggleProductActiveCommand}"
                            Visibility="{Binding CanManageProducts, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Entrada de mercadoria" Command="{Binding StockEntryCommand}"
                            Visibility="{Binding CanAdjustStock, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Ajuste por contagem" Command="{Binding AdjustStockCommand}"
                            Visibility="{Binding CanAdjustStock, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Histórico de estoque" Command="{Binding ShowStockHistoryCommand}" />
                </WrapPanel>

                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                          RowHeight="30" GridLinesVisibility="Horizontal" MouseDoubleClick="OnProductDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Códigos" Binding="{Binding Barcodes}" Width="*" />
                        <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryName}" Width="120" />
                        <DataGridTextColumn Header="Un" Binding="{Binding Unit}" Width="45" />
                        <DataGridTextColumn Header="Custo" Binding="{Binding CostPrice, StringFormat=C}" Width="90" />
                        <DataGridTextColumn Header="Venda" Binding="{Binding SalePrice, StringFormat=C}" Width="90" />
                        <DataGridTextColumn Header="Margem" Binding="{Binding MarginPercent, StringFormat={}{0:0.0}%}" Width="75" />
                        <DataGridTextColumn Header="Estoque" Binding="{Binding Stock, StringFormat={}{0:0.###}}" Width="75" />
                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding IsActive}" Width="55" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Usuários" Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibility}}">
            <DockPanel Margin="8">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Novo usuário" Command="{Binding NewUserCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Redefinir senha" Command="{Binding ResetPasswordCommand}" />
                    <Button Content="Alterar perfil" Command="{Binding ChangeRoleCommand}" />
                    <Button Content="Ativar / desativar" Command="{Binding ToggleUserActiveCommand}" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="Perfis: Administrador (tudo), Supervisor (desconto, cancelamento, sangria/suprimento, relatórios), Operador (apenas vender)." />
                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                          RowHeight="30" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Login" Binding="{Binding Username}" Width="160" />
                        <DataGridTextColumn Header="Nome" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="Perfil" Binding="{Binding RoleName}" Width="160" />
                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding IsActive}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
