<Window x:Class="Pdv.Desktop.Views.ProductEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="14" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" Background="{StaticResource SurfaceBrush}"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Descrição" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" MaxLength="120" />

        <TextBlock Grid.Row="1" Text="Unidade" VerticalAlignment="Center" />
        <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" Text="{Binding Unit}" Margin="0,4" Width="100" HorizontalAlignment="Left">
            <ComboBoxItem Content="UN" />
            <ComboBoxItem Content="KG" />
            <ComboBoxItem Content="L" />
            <ComboBoxItem Content="M" />
            <ComboBoxItem Content="CX" />
            <ComboBoxItem Content="PC" />
        </ComboBox>

        <TextBlock Grid.Row="2" Text="Categoria" VerticalAlignment="Center" />
        <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" ItemsSource="{Binding Categories}" Text="{Binding Category}" Margin="0,4" />

        <TextBlock Grid.Row="3" Text="Preço de venda" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Width="140" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="4" Text="Custo" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Width="140" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="5" Text="Códigos de barras&#x0a;(um por linha)" Margin="0,8,0,0" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Barcodes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"
                 AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" MinWidth="90" />
            <Button Content="Salvar" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
