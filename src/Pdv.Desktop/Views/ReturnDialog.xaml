<Window x:Class="Pdv.Desktop.Views.ReturnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pdv.Desktop.Controls"
        Title="{Binding Title}" Width="820" Height="600" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True" Background="{StaticResource BackgroundBrush}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrandSoftBrush}">
                <ui:IconView Data="{StaticResource Icon.Undo}" Foreground="{StaticResource BrandBrush}" Width="22" Height="22" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SaleInfo}" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Cancelar" IsCancel="True" MinWidth="100" />
                <ui:IconButton Style="{StaticResource PrimaryIconButton}" Icon="{StaticResource Icon.Check}" Content="Confirmar devolução"
                               IsDefault="True" Click="OnConfirm" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Como devolver o valor" Style="{StaticResource Caption}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                    <RadioButton Content="Vale-troca (para trocar por outro produto)" IsChecked="{Binding RefundInVoucher}" Margin="0,0,20,0" />
                    <RadioButton Content="Dinheiro (sai da gaveta)" IsChecked="{Binding RefundInCash}" />
                </StackPanel>
                <TextBlock Text="Motivo" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: tamanho errado, defeito, troca de cor" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource InkBrush}" CornerRadius="10" Padding="16,10" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=C}" Foreground="White" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Valor a devolver" Foreground="#CBD5E1" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="False" Margin="6,4" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ITEM" Binding="{Binding Line.Description}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="VENDIDO" Binding="{Binding Sold}" Width="85" IsReadOnly="True" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="DISPONÍVEL" Binding="{Binding Available}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="PAGO/UN" Binding="{Binding Line.UnitPaid, StringFormat=C}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTemplateColumn Header="DEVOLVER" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Tag="0" Padding="8,3" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="VALOR" Binding="{Binding Estimated, StringFormat=C}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource NumericCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
