<Window x:Class="Pdv.Desktop.Views.PurchaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pdv.Desktop.Controls"
        Title="{Binding Title}" Width="1120" Height="680" MinWidth="900" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True" Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:InvertBoolConverter x:Key="InvertBool" />
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrandSoftBrush}">
                    <ui:IconView Data="{StaticResource Icon.Truck}" Foreground="{StaticResource BrandBrush}" Width="22" Height="22" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Header}" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>

            <Grid Margin="0,12,0,0" Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Fornecedor" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Nº da nota (opcional)" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,10,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Data="{StaticResource Icon.Alert}" Foreground="{StaticResource WarningBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" IsCancel="True" MinWidth="100" />
                <ui:IconButton Style="{StaticResource PrimaryIconButton}" Icon="{StaticResource Icon.Check}" Content="Confirmar entrada"
                               Click="OnConfirm" />
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
                <ui:IconButton Icon="{StaticResource Icon.Search}" Content="Vincular produto" Command="{Binding LinkSelectedCommand}" Margin="0,0,8,0" />
                <ui:IconButton Icon="{StaticResource Icon.Plus}" Content="Criar produto" Command="{Binding CreateProductForSelectedCommand}" Margin="0,0,8,0"
                               Visibility="{Binding IsFromXml, Converter={StaticResource BoolToVisibility}}" />
                <ui:IconButton Icon="{StaticResource Icon.Plus}" Content="Adicionar item" Command="{Binding AddItemCommand}" Margin="0,0,8,0"
                               Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />
                <ui:IconButton Icon="{StaticResource Icon.Trash}" Content="Remover item" Command="{Binding RemoveSelectedCommand}" Margin="0"
                               Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="2,10,2,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Total da entrada " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Total, StringFormat=C}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" IsReadOnly="False" Margin="6,4">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ITEM DA NOTA" Width="2*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}">
                                        <Run Text="cód. " /><Run Text="{Binding SupplierCode, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Unit, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="QTD NOTA" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditable, Converter={StaticResource InvertBool}}" Padding="6,3" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="VALOR" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding TotalText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditable, Converter={StaticResource InvertBool}}" Padding="6,3" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="PRODUTO DA LOJA" Width="2*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:IconView Width="16" Height="16" Margin="0,0,6,0">
                                        <ui:IconView.Style>
                                            <Style TargetType="ui:IconView" BasedOn="{StaticResource {x:Type ui:IconView}}">
                                                <Setter Property="Data" Value="{StaticResource Icon.Alert}" />
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLinked}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource Icon.Check}" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:IconView.Style>
                                    </ui:IconView>
                                    <TextBlock Text="{Binding LinkText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="FATOR" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding FactorText, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"
                                         ToolTip="Unidades de estoque em cada unidade da nota (ex.: caixa com 12 = 12)" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ENTRA NO ESTOQUE" Binding="{Binding StockQuantity, StringFormat={}{0:0.###}}" Width="150" IsReadOnly="True" ElementStyle="{StaticResource NumericCell}" />
                    <DataGridTextColumn Header="CUSTO/UN" Binding="{Binding UnitCost, StringFormat={}{0:C4}}" Width="105" IsReadOnly="True" ElementStyle="{StaticResource NumericCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
