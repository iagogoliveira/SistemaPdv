<Window x:Class="Pdv.Desktop.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo usuário" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="14" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" Background="{StaticResource SurfaceBrush}"
        FocusManager.FocusedElement="{Binding ElementName=LoginBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Login" />
        <TextBox x:Name="LoginBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" MaxLength="60" />
        <TextBlock Text="Nome de exibição" />
        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" MaxLength="100" />
        <TextBlock Text="Perfil" />
        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" DisplayMemberPath="Name" Margin="0,4,0,10" />
        <TextBlock Text="Senha inicial" />
        <PasswordBox x:Name="PasswordBox" Margin="0,4,0,10" />
        <TextBlock Text="Repita a senha" />
        <PasswordBox x:Name="ConfirmBox" Margin="0,4,0,10" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancelar" IsCancel="True" MinWidth="90" />
            <Button Content="Criar" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
