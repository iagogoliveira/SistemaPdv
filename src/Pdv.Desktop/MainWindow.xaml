<Window x:Class="Pdv.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pdv.Desktop.Controls"
        Title="Sistema PDV — Frente de caixa" Width="1280" Height="760" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding OpenAdminCommand}" />
        <KeyBinding Key="F2" Command="{Binding OpenCashCommand}" />
        <KeyBinding Key="F3" Command="{Binding SupplyCommand}" />
        <KeyBinding Key="F4" Command="{Binding WithdrawCommand}" />
        <KeyBinding Key="F5" Command="{Binding DiscountItemCommand}" />
        <KeyBinding Key="F6" Command="{Binding RemoveSelectedItemCommand}" />
        <KeyBinding Key="F7" Command="{Binding CancelSaleCommand}" />
        <KeyBinding Key="F8" Command="{Binding ReprintCommand}" />
        <KeyBinding Key="F9" Command="{Binding AddPaymentCommand}" />
        <KeyBinding Key="F10" Command="{Binding FinalizeCommand}" />
        <KeyBinding Key="F12" Command="{Binding CloseCashCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ClearCartCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- ===== Cabeçalho ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Situação do caixa -->
                    <Border CornerRadius="16" Padding="12,6" Margin="0,0,12,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#26FFFFFF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCashOpen}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#4ADE80" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCashOpen}" Value="False">
                                                <Setter Property="Fill" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding CashStatus}" Foreground="White" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Operador -->
                    <Border CornerRadius="16" Padding="10,6" Background="#26FFFFFF" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconView Data="{StaticResource Icon.User}" Foreground="White" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding OperatorName}" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ClockText" Foreground="White" FontSize="20" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource LogoImage}" Width="38" Height="38" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Sistema PDV" Foreground="White" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
                        <TextBlock Text="{Binding TerminalLabel}" Foreground="#BFDBFE" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Teclas de função ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,6">
            <WrapPanel HorizontalAlignment="Center">
                <ui:IconButton Style="{StaticResource FunctionKeyButton}" Hint="F1" Icon="{StaticResource Icon.Store}"
                               Content="Retaguarda" Command="{Binding OpenAdminCommand}"
                               Visibility="{Binding CanOpenAdmin, Converter={StaticResource BoolToVisibility}}" />
                <ui:IconButton Style="{StaticResource FunctionKeyButton}" Hint="F2" Icon="{StaticResource Icon.Unlock}"
                               Content="Abrir caixa" Command="{Binding OpenCashCommand}" />
                <ui:IconButton Style="{StaticResource FunctionKeyButton}" Hint="F3" Icon="{StaticResource Icon.CashIn}"
                               Content="Suprimento" Command="{Binding SupplyCommand}" />
                <ui:IconButton Style="{StaticResource FunctionKeyButton}" Hint="F4" Icon="{StaticResource Icon.CashOut}"
                               Content="Sangria" Command="{Binding WithdrawCommand}" />
                <ui:IconButton Style="{StaticResource FunctionKeyButton}" Hint="F5" Icon="{StaticResource Icon.Tag}"
                               Content="Desconto" Command="{Binding DiscountItemCommand}" />
                <ui:IconButton Style="{StaticResource FunctionKeyButton}" Hint="F6" Icon="{StaticResource Icon.Trash}"
                               Content="Remover item" Command="{Binding RemoveSelectedItemCommand}" />
                <ui:IconButton Style="{StaticResource FunctionKeyButton}" Hint="F7" Icon="{StaticResource Icon.XCircle}"
                               Content="Cancelar venda" Command="{Binding CancelSaleCommand}" />
                <ui:IconButton Style="{StaticResource FunctionKeyButton}" Hint="F8" Icon="{StaticResource Icon.Printer}"
                               Content="Reimprimir" Command="{Binding ReprintCommand}" />
                <ui:IconButton Style="{StaticResource FunctionKeyButton}" Hint="Esc" Icon="{StaticResource Icon.Undo}"
                               Content="Descartar" Command="{Binding ClearCartCommand}" />
                <ui:IconButton Style="{StaticResource FunctionKeyButton}" Hint="F12" Icon="{StaticResource Icon.Lock}"
                               Content="Fechar caixa" Command="{Binding CloseCashCommand}" />
            </WrapPanel>
        </Border>

        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- ===== Coluna da venda ===== -->
            <DockPanel Grid.Column="0">
                <!-- Leitura de código -->
                <Grid DockPanel.Dock="Top">
                    <TextBox x:Name="CodeBox" Style="{StaticResource ScanBox}"
                             Tag="Passe o código de barras ou digite o nome do produto"
                             Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddItemCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <ui:IconView Data="{StaticResource Icon.Barcode}" Foreground="{StaticResource BrandBrush}"
                                 Width="26" Height="26" HorizontalAlignment="Left" Margin="16,0,0,0" IsHitTestVisible="False" />
                    <!-- Para quem usa mouse/tela de toque; o leitor e o teclado usam Enter. -->
                    <ui:IconButton Style="{StaticResource PrimaryIconButton}" Icon="{StaticResource Icon.Plus}" Content="Adicionar"
                                   Hint="Enter" Command="{Binding AddItemCommand}" HorizontalAlignment="Right" Margin="0,0,8,0"
                                   MinHeight="44" Focusable="False" />
                </Grid>

                <!-- Mensagem de status -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,10,0,12">
                    <ui:IconView Data="{StaticResource Icon.Info}" Foreground="{StaticResource MutedBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Text="   ·   Dica: 3*código lança 3 unidades" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Destaque do último item (visível para o cliente) -->
                <Border DockPanel.Dock="Top" CornerRadius="12" Padding="18,14" Margin="0,0,0,14"
                        Background="{StaticResource BrandSoftBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1">
                    <Grid>
                        <!-- Com item -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource BrandBrush}" VerticalAlignment="Center">
                                <ui:IconView Data="{StaticResource Icon.Box}" Foreground="White" Width="28" Height="28" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LastItem.Product.Name}" FontSize="22" FontWeight="SemiBold"
                                           FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" Language="pt-BR">
                                    <Run Text="{Binding LastItem.Quantity, Mode=OneWay, StringFormat={}{0:0.###}}" />
                                    <Run Text="{Binding LastItem.Product.Unit, Mode=OneWay}" />
                                    <Run Text="×" />
                                    <Run Text="{Binding LastItem.Product.SalePrice, Mode=OneWay, StringFormat=C}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding LastItem.Total, StringFormat=C}" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource BrandPressedBrush}" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                        </Grid>
                        <!-- Sem item -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="52" Height="52" CornerRadius="12" Background="White">
                                <ui:IconView Data="{StaticResource Icon.Cart}" Foreground="{StaticResource BrandBrush}" Width="28" Height="28" />
                            </Border>
                            <StackPanel Margin="16,0" VerticalAlignment="Center">
                                <TextBlock Text="Caixa livre" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                                <TextBlock Text="Seja bem-vindo! Pronto para a próxima venda." Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Itens da venda -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Focusable="False" Margin="6,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number, StringFormat={}{0:00}}" Width="48" />
                                <DataGridTemplateColumn Header="PRODUTO" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Product.Barcode}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="QTD" Width="80" ElementStyle="{StaticResource NumericCell}"
                                                    Binding="{Binding Quantity, StringFormat={}{0:0.###}}" />
                                <DataGridTextColumn Header="UN" Binding="{Binding Product.Unit}" Width="50" />
                                <DataGridTextColumn Header="PREÇO" Width="100" ElementStyle="{StaticResource NumericCell}"
                                                    Binding="{Binding Product.SalePrice, StringFormat=C}" />
                                <DataGridTemplateColumn Header="DESCONTO" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <Binding Path="Discount" StringFormat="{}{0:'- R$ '#,##0.00;;''}" />
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="TOTAL" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Margin="0,0,6,0"
                                                       Text="{Binding Total, StringFormat=C}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Estado vazio -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ItemCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource BackgroundBrush}" HorizontalAlignment="Center">
                                <ui:IconView Data="{StaticResource Icon.Barcode}" Foreground="#94A3B8" Width="40" Height="40" />
                            </Border>
                            <TextBlock Text="Nenhum item na venda" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock Text="Leia o código de barras do produto para começar." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- ===== Coluna do pagamento ===== -->
            <DockPanel Grid.Column="2">
                <!-- Total -->
                <Border DockPanel.Dock="Top" CornerRadius="14" Padding="22,18" Background="{StaticResource InkBrush}" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="TOTAL A PAGAR" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="{Binding Total, StringFormat=C}" Foreground="White" FontSize="52" FontWeight="Bold"
                                   FontFamily="{StaticResource DisplayFont}" Margin="0,2,0,4" />
                        <TextBlock Foreground="#CBD5E1" FontSize="13" Language="pt-BR">
                            <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" item(ns)" />
                            <Run Text="   ·   descontos " /><Run Text="{Binding DiscountTotal, Mode=OneWay, StringFormat=C}" Foreground="#86EFAC" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Finalizar -->
                <ui:IconButton DockPanel.Dock="Bottom" Style="{StaticResource SuccessIconButton}" Icon="{StaticResource Icon.Check}"
                               Hint="F10" Content="Finalizar venda" Command="{Binding FinalizeCommand}"
                               FontSize="19" MinHeight="64" Margin="0,14,0,0" />

                <!-- Pagamento -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Forma de pagamento" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
                        <ListBox DockPanel.Dock="Top" Style="{StaticResource TileListBox}" Focusable="False"
                                 ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding SelectedPayment}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:IconView x:Name="PayIcon" Data="{StaticResource Icon.Cash}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Width="22" Height="22" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Method}" Value="Pix">
                                            <Setter TargetName="PayIcon" Property="Data" Value="{StaticResource Icon.Pix}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Method}" Value="DebitCard">
                                            <Setter TargetName="PayIcon" Property="Data" Value="{StaticResource Icon.Card}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Method}" Value="CreditCard">
                                            <Setter TargetName="PayIcon" Property="Data" Value="{StaticResource Icon.CardContactless}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock DockPanel.Dock="Top" Text="Valor recebido  ·  vazio = valor que falta" Style="{StaticResource Caption}" Margin="2,14,0,6" />
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AmountBox" FontSize="20" Tag="0,00"
                                     Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddPaymentCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <ui:IconButton Grid.Column="1" Style="{StaticResource PrimaryIconButton}" Icon="{StaticResource Icon.Plus}"
                                           Hint="F9" Content="Lançar" Command="{Binding AddPaymentCommand}" Margin="8,0,0,0" />
                        </Grid>

                        <!-- Resumo -->
                        <Grid DockPanel.Dock="Bottom" Margin="2,12,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Pago" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Paid, StringFormat=C}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="Falta" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Remaining, StringFormat=C}" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="-8,10,-8,0" Padding="12,10" CornerRadius="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Change, StringFormat=C}" FontSize="26" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}" FontFamily="{StaticResource DisplayFont}" />
                                    <TextBlock Text="Troco" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Pagamentos lançados -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding Payments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="12,4,4,4" Margin="0,3">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" ToolTip="Remover pagamento" Padding="6" MinHeight="0" Margin="6,0,0,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <ui:IconView Data="{StaticResource Icon.X}" Foreground="{StaticResource MutedBrush}" Width="14" Height="14" />
                                                </Button>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, StringFormat=C}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <ui:IconView Data="{StaticResource Icon.Check}" Foreground="{StaticResource SuccessBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
